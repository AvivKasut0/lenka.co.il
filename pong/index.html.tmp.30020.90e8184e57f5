<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>lenka pong</title>
  <link rel="icon" href="../images/dvirbride.png">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; background: #05060f; }
    canvas { display: block; }
  </style>
</head>
<body>
<canvas id="c"></canvas>
<script>
  // ── images ────────────────────────────────────
  const playerImg = new Image();
  playerImg.src = '../images/dvirbride.png';

  const ballImg = new Image();
  ballImg.src = '../images/dvirkiss.png';

  // ── constants ─────────────────────────────────
  const PW         = 30;    // AI paddle width
  const PH         = 210;   // AI paddle height
  const BR         = 20;    // ball collision radius
  const BALL_SIZE  = 78;    // ball image drawn size
  const BALL_SPEED = 3.5;
  const AI_SPEED   = 2.6;
  const PLAYER_H   = 240;   // player paddle drawn height (natural proportions)

  // ── setup ─────────────────────────────────────
  const canvas = document.getElementById('c');
  const ctx    = canvas.getContext('2d');

  // compute player width from natural image ratio once loaded
  let playerW = 80;
  playerImg.onload = () => {
    playerW = Math.round(PLAYER_H * playerImg.naturalWidth / playerImg.naturalHeight);
  };

  let W, H;
  let state;
  let ball;
  let leftY, rightY;
  let scoreL, scoreR;
  const keys = {};

  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }

  function lx() { return 28; }
  function rx() { return W - 28 - playerW; }
  function clampAI(y)     { return Math.max(0, Math.min(H - PH, y)); }
  function clampPlayer(y) { return Math.max(0, Math.min(H - PLAYER_H, y)); }

  function newBall(goRight = true) {
    const angle = (Math.random() * 0.8 - 0.4);
    ball = {
      x:  W / 2,
      y:  H / 2,
      vx: (goRight ? 1 : -1) * BALL_SPEED * Math.cos(angle),
      vy: BALL_SPEED * Math.sin(angle),
      rot: 0,
    };
  }

  function resetGame() {
    leftY  = H / 2 - PH / 2;
    rightY = H / 2 - PLAYER_H / 2;
    scoreL = 0;
    scoreR = 0;
    newBall(true);
    state = 'waiting';
  }

  // ── input ─────────────────────────────────────
  window.addEventListener('keydown', e => {
    keys[e.key] = true;
    if (state === 'waiting') state = 'playing';
  });
  window.addEventListener('keyup', e => { keys[e.key] = false; });

  window.addEventListener('mousemove', e => {
    if (state === 'playing') rightY = clampPlayer(e.clientY - PLAYER_H / 2);
  });

  window.addEventListener('touchmove', e => {
    e.preventDefault();
    for (const t of e.touches) {
      rightY = clampPlayer(t.clientY - PLAYER_H / 2);
    }
  }, { passive: false });

  window.addEventListener('touchstart', () => {
    if (state === 'waiting') state = 'playing';
  });

  window.addEventListener('resize', () => { resize(); resetGame(); });

  // ── update ────────────────────────────────────
  function update() {
    if (state !== 'playing') return;

    if (keys['ArrowUp']   || keys['w'] || keys['W']) rightY = clampPlayer(rightY - 9);
    if (keys['ArrowDown'] || keys['s'] || keys['S']) rightY = clampPlayer(rightY + 9);

    // AI tracks ball on left
    const aiTarget = ball.y - PH / 2;
    const diff = aiTarget - leftY;
    leftY = clampAI(leftY + Math.sign(diff) * Math.min(Math.abs(diff), AI_SPEED));

    ball.x += ball.vx;
    ball.y += ball.vy;

    // spin proportional to speed
    ball.rot += Math.hypot(ball.vx, ball.vy) * 0.04;

    // top / bottom walls
    if (ball.y - BR <= 0)  { ball.y = BR;     ball.vy =  Math.abs(ball.vy); }
    if (ball.y + BR >= H)  { ball.y = H - BR; ball.vy = -Math.abs(ball.vy); }

    // left paddle (AI)
    if (
      ball.vx < 0 &&
      ball.x - BR <= lx() + PW &&
      ball.x + BR >= lx() &&
      ball.y + BR >= leftY &&
      ball.y - BR <= leftY + PH
    ) {
      ball.x = lx() + PW + BR;
      const rel   = (ball.y - (leftY + PH / 2)) / (PH / 2);
      const spd   = Math.min(Math.hypot(ball.vx, ball.vy) + 0.2, 14);
      const angle = rel * 0.85;
      ball.vx =  spd * Math.cos(angle);
      ball.vy =  spd * Math.sin(angle);
    }

    // right paddle (player)
    if (
      ball.vx > 0 &&
      ball.x + BR >= rx() &&
      ball.x - BR <= rx() + playerW &&
      ball.y + BR >= rightY &&
      ball.y - BR <= rightY + PLAYER_H
    ) {
      ball.x = rx() - BR;
      const rel   = (ball.y - (rightY + PLAYER_H / 2)) / (PLAYER_H / 2);
      const spd   = Math.min(Math.hypot(ball.vx, ball.vy) + 0.2, 14);
      const angle = rel * 0.85;
      ball.vx = -spd * Math.cos(angle);
      ball.vy =  spd * Math.sin(angle);
    }

    // scoring
    if (ball.x < -BR * 2) { scoreR++; scored(false); }
    if (ball.x > W + BR * 2) { scoreL++; scored(true); }
  }

  function scored(serveLeft) {
    state = 'scored';
    setTimeout(() => { newBall(serveLeft); state = 'playing'; }, 900);
  }

  // ── draw ──────────────────────────────────────
  function drawAIPaddle(x, y) {
    ctx.save();
    ctx.shadowColor = 'rgba(180,200,255,0.7)';
    ctx.shadowBlur  = 18;
    ctx.fillStyle   = 'rgba(210,220,255,0.9)';
    ctx.beginPath();
    ctx.roundRect(x, y, PW, PH, 5);
    ctx.fill();
    ctx.restore();
  }

  function drawPlayerPaddle(x, y) {
    if (playerImg.naturalWidth) {
      ctx.save();
      ctx.shadowColor = 'rgba(255,255,255,0.3)';
      ctx.shadowBlur  = 20;
      // mirror so it faces left (inward)
      ctx.translate(x + playerW, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(playerImg, 0, y, playerW, PLAYER_H);
      ctx.restore();
    } else {
      ctx.fillStyle = '#fff';
      ctx.fillRect(x, y, playerW, PLAYER_H);
    }
  }

  function drawBall() {
    ctx.save();
    ctx.translate(ball.x, ball.y);
    ctx.rotate(ball.rot);
    if (ballImg.naturalWidth) {
      ctx.drawImage(ballImg, -BALL_SIZE / 2, -BALL_SIZE / 2, BALL_SIZE, BALL_SIZE);
    } else {
      ctx.shadowColor = 'rgba(255,255,255,0.9)';
      ctx.shadowBlur  = 22;
      ctx.beginPath();
      ctx.arc(0, 0, BR, 0, Math.PI * 2);
      ctx.fillStyle = '#fff';
      ctx.fill();
    }
    ctx.restore();
  }

  function draw() {
    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#05060f');
    grad.addColorStop(1, '#0b0d1a');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // centre line
    ctx.save();
    ctx.setLineDash([6, 16]);
    ctx.strokeStyle = 'rgba(255,255,255,0.07)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(W / 2, 0);
    ctx.lineTo(W / 2, H);
    ctx.stroke();
    ctx.restore();

    drawAIPaddle(lx(), leftY);
    drawPlayerPaddle(rx(), rightY);
    drawBall();

    // score
    ctx.font = 'bold 42px monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.fillText(`${scoreL}  —  ${scoreR}`, W / 2, 62);

    if (state === 'waiting') {
      ctx.font = '18px monospace';
      ctx.fillStyle = 'rgba(255,255,255,0.22)';
      ctx.fillText('move mouse · arrow keys · tap to start', W / 2, H / 2 + PLAYER_H);
    }
  }

  // ── loop ──────────────────────────────────────
  function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
  }

  resize();
  resetGame();
  loop();
</script>
</body>
</html>
